<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Arena" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/arena_background</item>
        <item name="android:navigationBarColor">@color/arena_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowSplashScreenBackground">@color/arena_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/arena_mark</item>
    </style>
</resources>
