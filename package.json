{
  "name": "esports-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "wrangler dev",
    "dev:web": "vite apps/web",
    "dev:web-mobile": "vite apps/web-mobile",
    "dev:web-v2": "vite apps/web-v2",
    "build:web": "npm run build --workspace @esports-live/web",
    "build:web-mobile": "npm run build --workspace @esports-live/web-mobile",
    "build:web-v2": "npm run build --workspace @esports-live/web-v2",
    "deploy:api": "wrangler deploy",
    "deploy:web": "npm run build:web && wrangler pages deploy apps/web/dist --project-name esports-live",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test packages/core/src/*.test.ts packages/adapter-lol/src/*.test.ts apps/api/src/*.test.ts",
    "test:web": "npm run build:web && playwright test",
    "test:web-mobile": "npm run build:web-mobile && WEB_APP_ROOT=apps/web-mobile playwright test tests/web/mobile- tests/web/completed-board-merge.spec.ts tests/web/live-telemetry-pending.spec.ts",
    "test:web-v2": "npm run build:web-v2 && WEB_APP_ROOT=apps/web-v2 playwright test tests/web/web-v2-",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "4.119.0"
  },
  "engines": {
    "node": ">=24"
  }
}
